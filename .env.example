# GROQ_API_KEY: Required for Groq LLM chat (llama-3.3-70b-versatile) and vision models.
# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# HF_TOKEN: Required for Hugging Face Inference API (FLUX.1-schnell Image & Text-to-Video).
# Get a free token from https://huggingface.co/settings/tokens
HF_TOKEN="MY_HUGGINGFACE_TOKEN"

# GEMINI_API_KEY: Optional fallback / AI Studio runtime secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
